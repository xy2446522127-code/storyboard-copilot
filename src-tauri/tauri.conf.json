{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "花海画布",
  "version": "5.8.1",
  "identifier": "com.huahai.canvas",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/huahai-canvas.ico", "icons/huahai-canvas.png"],
    "resources": ["../tools/jimeng_browser.py"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/huahai-canvas.ico",
        "uninstallerIcon": "icons/huahai-canvas.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwNDc5OTBDRUZCRkI1MUQKUldRZHRiL3ZESmxIMEZFUVNrZkdnbmVoNDQ2Wk11MTN4RnBrSGlSNzQwTWQvMVlRaThNS3U0Uk4K",
      "endpoints": [
        "https://github.com/xy2446522127-code/storyboard-copilot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
