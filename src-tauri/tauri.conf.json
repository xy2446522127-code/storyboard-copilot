{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "花海画布",
  "version": "5.6.1",
  "identifier": "cc.zhiyao.storyboard-copilot",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "花海画布",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/huahai-canvas.ico", "icons/huahai-canvas.png"],
    "resources": ["../tools/jimeng_browser.py"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/huahai-canvas.ico",
        "uninstallerIcon": "icons/huahai-canvas.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlERkMwQjM2NTY2NDBFNDEKUldSQkRtUldOZ3Y4blg4emVLUGhiQVdNTTIrK3VaRkIxNUlsOUFzNVF4Q25kTUVjT3BwRnBVZ1gK",
      "endpoints": [
        "https://github.com/xy2446522127-code/storyboard-copilot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
